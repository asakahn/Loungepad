<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- For NotifyIcon only (TrayIcon.cs); WPF has no tray icon of its own. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Loungepad</AssemblyName>
    <RootNamespace>Loungepad</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Loungepad.ico</ApplicationIcon>
    <Version>1.11.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- UseWindowsForms would import these everywhere, and half their names (Application,
         MessageBox, Point, Color) are WPF's too. TrayIcon imports what it uses. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Loungepad.Input\Loungepad.Input.csproj" />
    <Compile Remove="Interop\NativeMethods.cs;Interop\HidNative.cs;Services\HidGamepadReader.cs;Services\StickPointer.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2739.15" />
    <!-- DPAPI, for the store sign-in tokens kept under %APPDATA%\Loungepad\accounts. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <!-- Reads Playnite's library for the import (Services/PlayniteImport.cs). 5.x, not the 4.1.4 Playnite
         itself uses: 4.x carries a critical advisory, and 5 reads v4 files by upgrading a copy. -->
    <PackageReference Include="LiteDB" Version="5.0.21" />
  </ItemGroup>

  <ItemGroup>
    <!-- Everything the app reads besides its own code ships INSIDE the exe, so a release is one
         file (ShippedFiles reads them back by path): the page (ui, served to the WebView by
         MainWindow), the bundled themes (copied into the user's themes folder by
         ThemeService.SyncBuiltIn) and the Vortex extension (copied into Vortex's plugins folder
         by VortexBackend.SyncPlugin). Nothing is copied beside the exe any more.
         WithCulture="false": a name like "x.de.js" must not be taken for a German satellite. -->
    <EmbeddedResource Include="ui\**\*;themes\**\*;vortex-bridge\**\*"
                      LogicalName="shipped\%(RelativeDir)%(Filename)%(Extension)" WithCulture="false" />
    <!-- The license and the third-party notices travel inside the one file too, as they did
         beside the exe in the zip. -->
    <EmbeddedResource Include="..\LICENSE;..\NOTICE" LogicalName="shipped\%(Filename)%(Extension)" WithCulture="false" />
    <EmbeddedResource Include="..\tools\install-input-service.ps1;..\tools\uninstall-input-service.ps1"
                      LogicalName="shipped\setup\%(Filename)%(Extension)" WithCulture="false" />
    <!-- This version's release notes, the GitHub release's own text, shown once after an update
         (UiBridge.PushWhatsNew). Only this version's file: a build with no notes shows nothing. -->
    <EmbeddedResource Include="..\release-notes\v$(Version).md" LogicalName="shipped\whatsnew.md" WithCulture="false"
                      Condition="Exists('..\release-notes\v$(Version).md')" />
    <!-- ApplicationIcon gives the exe its icon; Resource also embeds it so the window itself
         (and therefore Alt-Tab) can use it, since there is no taskbar button to carry one -->
    <Resource Include="Loungepad.ico" />
  </ItemGroup>

</Project>
